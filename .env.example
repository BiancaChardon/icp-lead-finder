# Copy to .env and replace the placeholders. Never commit .env.
#   cp .env.example .env

# development | production
APP_ENV=development

# PostgreSQL (internal to Docker; not published to the host)
POSTGRES_DB=icp_lead_finder
POSTGRES_USER=icp_app
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Comma-separated list of browser origins allowed to call the backend directly.
# Wildcards ("*") are rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
